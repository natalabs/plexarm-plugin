#!/bin/sh
# Plexarm — the MCP Authorization header, minted at connect time from a
# credential store you control. Claude Code runs this once per connect and uses
# its stdout as the request headers (`headersHelper` in .mcp.json).
#
# IT PRINTS ONE LINE OF JSON ON STDOUT AND NOTHING ELSE, AND IT ALWAYS EXITS 0.
# A failing helper makes the client fall back to an OAuth flow whose error names
# nothing a person can act on. So every path that cannot produce a real
# credential emits the sentinel below instead, and the server answers it with a
# sentence that says how to store a token.
#
# Where it looks, in order — the first non-empty answer wins:
#   1. macOS Keychain        /usr/bin/security find-generic-password -s plexarm-api-token -w
#   2. Linux Secret Service  /usr/bin/secret-tool lookup service plexarm-api-token
#   3. A file                $HOME/.config/plexarm/token, mode 600 or 400, owned by you
#
# It never takes the token as an argument, never reads it from the environment,
# never writes it anywhere, and never contacts the network.
#
PATH=/usr/bin:/bin; export PATH
unset BASH_ENV ENV CDPATH
# Space, tab, newline — written literally. `IFS=' \t\n'` in sh is a backslash,
# a `t`, a backslash and an `n`, which is not what anybody means by it.
IFS=' 	
'
set -u

# The home directory comes from the password database, not the environment.
me_name=$(/usr/bin/id -un 2>/dev/null) || me_name=
case "$me_name" in
  ''|*[!A-Za-z0-9._-]*) ;;
  *) eval "pw_home=~$me_name"
     case "$pw_home" in
       /*) HOME=$pw_home; export HOME ;;
     esac ;;
esac

# COMPILED IN. The destination is not a parameter and never becomes one.
ENDPOINT=https://api.plexarm.com/mcp
SERVICE=plexarm-api-token
TOKEN_FILE_SUFFIX=/.config/plexarm/token

# The credential this helper emits when it has none. It authenticates nothing;
# the API recognises this exact literal and answers 401 with a sentence naming
# the credential store. The API carries the same literal, so the two must
# change together.
SENTINEL=plexarm-no-local-credential

# Diagnostics go to stderr, which the client does not show, so nothing depends
# on them. They are for a person running this helper by hand to diagnose it.
note() { printf 'plexarm: %s\n' "$1" >&2; }

# The ONLY write to stdout in this file.
emit() { printf '{"Authorization":"Bearer %s"}\n' "$1"; exit 0; }

# ─────────────────────────────────────────────────────────────────────────────
# 1. WHERE IS THIS GOING? Answered BEFORE any store is opened.
# ─────────────────────────────────────────────────────────────────────────────
# The client passes the destination in CLAUDE_CODE_MCP_SERVER_URL. The header
# is minted only for the compiled-in endpoint.
destination=${CLAUDE_CODE_MCP_SERVER_URL-}
if [ "$destination" != "$ENDPOINT" ]; then
  note "refusing to mint a header for [$destination]. This helper authenticates $ENDPOINT and nothing else."
  emit "$SENTINEL"
fi

token=

# ─────────────────────────────────────────────────────────────────────────────
# 2. macOS Keychain
# ─────────────────────────────────────────────────────────────────────────────
if [ -x /usr/bin/security ]; then
  token=$(/usr/bin/security find-generic-password -s "$SERVICE" -w 2>/dev/null) || token=
fi

# ─────────────────────────────────────────────────────────────────────────────
# 3. Linux Secret Service (libsecret). Absolute path, never `command -v`.
# ─────────────────────────────────────────────────────────────────────────────
if [ -z "$token" ] && [ -x /usr/bin/secret-tool ]; then
  token=$(/usr/bin/secret-tool lookup service "$SERVICE" 2>/dev/null) || token=
fi

# ─────────────────────────────────────────────────────────────────────────────
# 4. A plain file — the headless / no-Secret-Service concession, not a peer
# ─────────────────────────────────────────────────────────────────────────────
# There is deliberately no variable naming the file.
file=${HOME-}$TOKEN_FILE_SUFFIX
if [ -z "$token" ] && [ -f "$file" ]; then
  mode=$(/usr/bin/stat -f '%Lp' "$file" 2>/dev/null) || mode=$(/usr/bin/stat -c '%a' "$file" 2>/dev/null) || mode=
  owner=$(/usr/bin/stat -f '%u' "$file" 2>/dev/null) || owner=$(/usr/bin/stat -c '%u' "$file" 2>/dev/null) || owner=
  me=$(/usr/bin/id -u) || me=
  dir=${file%/*}
  dir_mode=$(/usr/bin/stat -f '%Lp' "$dir" 2>/dev/null) || dir_mode=$(/usr/bin/stat -c '%a' "$dir" 2>/dev/null) || dir_mode=
  case "$dir_mode" in
    *[2367]) note "$dir can be written by other accounts. Run: chmod 700 $dir"
       emit "$SENTINEL" ;;
  esac
  # The permission bits are the only protection a plain file has, so a file
  # readable by anyone but its owner is refused rather than used.
  case "$mode" in
    600|400|0600|0400) ;;
    *) note "$file has mode ${mode:-unknown}; only 600 or 400 are accepted. Run: chmod 600 $file"
       emit "$SENTINEL" ;;
  esac
  if [ -z "$owner" ] || [ -z "$me" ] || [ "$owner" != "$me" ]; then
    note "$file is owned by uid ${owner:-unknown}, not by uid ${me:-unknown}. Refusing to read another account's credential."
    emit "$SENTINEL"
  fi
  token=$(/bin/cat "$file" 2>/dev/null) || token=
fi

# ─────────────────────────────────────────────────────────────────────────────
# 5. What came back
# ─────────────────────────────────────────────────────────────────────────────
token=$(printf '%s' "$token" | /usr/bin/tr -d '\r\n \t')

if [ -z "$token" ]; then
  note "no Plexarm credential found on this machine. Store one — macOS: security add-generic-password -a \"\$USER\" -s $SERVICE -w (it prompts, so the token never enters your shell history); Linux: secret-tool store --label=\"Plexarm API token\" service $SERVICE; or a file: umask 077; mkdir -p \"\$HOME/.config/plexarm\"; read -rs t && printf %s \"\$t\" > \"\$HOME$TOKEN_FILE_SUFFIX\". Create a token at https://plexarm.com/me; it is shown once."
  emit "$SENTINEL"
fi

case "$token" in
  *[!A-Za-z0-9_.~-]*)
    note "the stored Plexarm credential contains characters a token never has. Store it again, without quotes or trailing text."
    emit "$SENTINEL" ;;
esac

emit "$token"
